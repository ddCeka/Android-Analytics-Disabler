#!/system/bin/sh

# Auto-detect ANSI color support (interactive TTY only)
if [ -t 1 ] && [ "$TERM" != "dumb" ]; then
    RED=$(printf '\033[1;31m')
    GRN=$(printf '\033[1;32m')
    YLW=$(printf '\033[1;33m')
    CYN=$(printf '\033[1;36m')
    DIM=$(printf '\033[2m')
    RST=$(printf '\033[0m')
else
    RED=""
    GRN=""
    YLW=""
    CYN=""
    DIM=""
    RST=""
fi

# Helper functions for strict 60-column formatted output
print_line() {
    printf "%s+----------------------------------------------------------+%s\n" "$DIM" "$RST"
}

print_row() {
    # Truncates or pads plain text to 56 chars, keeping ANSI codes outside width math
    color="$2"
    printf "%s|%s %s%-56.56s%s %s|%s\n" "$DIM" "$RST" "$color" "$1" "$RST" "$DIM" "$RST"
}

print_wrap() {
    text="$1"
    color="$2"
    echo "$text" | fold -s -w 56 | while IFS= read -r line; do
        print_row "$line" "$color"
    done
}

print_header() {
    print_line
    print_row "$1" "$CYN"
    print_line
}

display_usage() {
    print_header "DSS - Analytics & Ads Disabler"
    print_row "Usage: dss [-n|--dry-run] {enable|disable}" ""
    print_row "           {user|system} [package]" ""
    print_row "" ""
    print_row "Options:" "$CYN"
    print_row "  -n, --dry-run  Preview matches without changes" ""
    if [ -n "$1" ]; then
        print_line
        print_wrap "Error: $1" "$RED"
    fi
    print_line
}

# Require root privileges
if [ "$(id -u)" -ne 0 ]; then
    display_usage "Root access required. Run 'su' first."
    exit 1
fi

# First-time initialization notice
if [ ! -e /data/.dss.init ]; then
    print_header "Analytics Disabler Reminder"
    print_wrap "Applying this script to 'system' apps may cause Google Play system updates to fail and reboot." "$YLW"
    print_row "" ""
    print_wrap "Remember to run this script with 'enable' BEFORE applying a Google Play system update." ""
    print_row "" ""
    print_wrap "You won't see this message when you run the script again." "$DIM"
    print_line
    touch /data/.dss.init
    exit 0
fi

# Parse optional dry-run flag
DRY_RUN=0
if [ "$1" = "-n" ] || [ "$1" = "--dry-run" ]; then
    DRY_RUN=1
    shift
fi

# Validate positional arguments
if [ $# -ne 2 ] && [ $# -ne 3 ]; then
    display_usage "Requires 2 or 3 arguments."
    exit 1
fi

if [ "$1" != "enable" ] && [ "$1" != "disable" ]; then
    display_usage "Action must be 'enable' or 'disable'."
    exit 1
fi

if [ "$2" != "user" ] && [ "$2" != "system" ]; then
    display_usage "Scope must be 'user' or 'system'."
    exit 1
fi

if [ "$2" = "user" ]; then
    FLAG="-3"
else
    FLAG="-s"
fi

PLIST=$(/system/bin/cmd package list packages -e "$FLAG" | grep -v Swift | sort | sed 's/package://g')

if [ $# -eq 3 ]; then
    if echo "$PLIST" | /system/bin/grep -Fxq "$3"; then
        PLIST="$3"
    else
        display_usage "Package '$3' not found or disabled."
        exit 1
    fi
fi

START_TIME=$(date +%s)
CMD="$1"
DCNT=0
ECNT=0
ERR=0
PKG_TOTAL=$(echo "$PLIST" | wc -l | tr -d ' ')
PKG_CURR=0

if [ "$DRY_RUN" -eq 1 ]; then
    ACTION_COLOR="$YLW"
    ACTION_LABEL="$CMD (DRY RUN - no changes)"
elif [ "$CMD" = "disable" ]; then
    ACTION_COLOR="$RED"
    ACTION_LABEL="$CMD"
else
    ACTION_COLOR="$GRN"
    ACTION_LABEL="$CMD"
fi

dodis() {
    if [ "$DRY_RUN" -eq 1 ]; then
        # Check cached package dump first, fallback to resolve-activity
        if printf '%s\n' "$PKG_DUMP" | grep -Fq "${2#*/}" || \
           /system/bin/cmd package resolve-activity --brief "$2" >/dev/null 2>&1; then
            if [ "$1" = "enable" ]; then
                ECNT=$(( ECNT + 1 ))
            else
                DCNT=$(( DCNT + 1 ))
            fi
        else
            ERR=$(( ERR + 1 ))
        fi
    else
        pm "$1" "$2" >/dev/null 2>&1
        if [ $? -eq 0 ]; then
            if [ "$1" = "enable" ]; then
                ECNT=$(( ECNT + 1 ))
            else
                DCNT=$(( DCNT + 1 ))
            fi
        else
            ERR=$(( ERR + 1 ))
        fi
    fi
}

print_header "DSS Execution Started"
print_row "Action : $ACTION_LABEL" "$ACTION_COLOR"
print_row "Scope  : $2 ($PKG_TOTAL package(s))" ""
print_line

for i in $PLIST; do
    PKG_CURR=$(( PKG_CURR + 1 ))
    # Live updating status line (stays within 60 columns)
    printf "\r%s|%s %s[%3d/%-3d]%s %-46.46s %s|%s" \
        "$DIM" "$RST" "$CYN" "$PKG_CURR" "$PKG_TOTAL" "$RST" "$i" "$DIM" "$RST"

    # Cache dumpsys output once per package during dry-run
    if [ "$DRY_RUN" -eq 1 ]; then
        PKG_DUMP=$(dumpsys package "$i" 2>/dev/null)
    fi

    # Global components applied to all selected packages
    dodis "$CMD" "$i/com.adjust.sdk.AdjustReferrerReceiver"
    dodis "$CMD" "$i/com.adjust.sdk.AdjustPreinstallReferrerReceiver"
    dodis "$CMD" "$i/com.alipay.sdk.app.APayEntranceActivity"
    dodis "$CMD" "$i/com.alipay.sdk.app.AlipayResultActivity"
    dodis "$CMD" "$i/com.alipay.sdk.app.H5AuthActivity"
    dodis "$CMD" "$i/com.alipay.sdk.app.H5OpenAuthActivity"
    dodis "$CMD" "$i/com.alipay.sdk.app.H5PayActivity"
    dodis "$CMD" "$i/com.alipay.sdk.app.PayResultActivity"
    dodis "$CMD" "$i/com.alipay.sdk.auth.AuthActivity"
    dodis "$CMD" "$i/com.amap.api.location.APSService"
    dodis "$CMD" "$i/com.android.billingclient.api.ProxyBillingActivity"
    dodis "$CMD" "$i/com.android.billingclient.api.ProxyBillingActivityV2"
    dodis "$CMD" "$i/com.appsflyer.MultipleInstallBroadcastReceiver"
    dodis "$CMD" "$i/com.braintreepayments.api.internal.AnalyticsIntentService"
    dodis "$CMD" "$i/com.crashlytics.android.CrashlyticsInitProvider"
    dodis "$CMD" "$i/com.facebook.CampaignTrackingReceiver"
    dodis "$CMD" "$i/com.facebook.ads.AudienceNetworkActivity"
    dodis "$CMD" "$i/com.facebook.ads.AudienceNetworkContentProvider"
    dodis "$CMD" "$i/com.facebook.ads.internal.ipc.AdsMessengerService"
    dodis "$CMD" "$i/com.facebook.ads.internal.ipc.AdsProcessPriorityService"
    dodis "$CMD" "$i/com.facebook.internal.FacebookInitProvider"
    dodis "$CMD" "$i/com.google.analytics.tracking.android.CampaignTrackingReceiver"
    dodis "$CMD" "$i/com.google.analytics.tracking.android.CampaignTrackingService"
    dodis "$CMD" "$i/com.google.android.gms.ads.AdActivity"
    dodis "$CMD" "$i/com.google.android.gms.ads.AdRequestBrokerService"
